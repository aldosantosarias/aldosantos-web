---
import {getCollection} from 'astro:content';
const publicaciones=(await getCollection('publicaciones')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const proyectos=(await getCollection('proyectos')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Aldo Santos. Investigación, consultoría y facilitación de procesos de diálogo."/><title>Aldo Santos — Investigación, consultoría y diálogo</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet"/><style>
:root{--ink:#17302a;--paper:#f7f5f0;--muted:#626a64;--line:#d7d9d0}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;line-height:1.65}a{color:inherit}header{padding:24px 6%;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.brand{font-family:'DM Serif Display',serif;letter-spacing:.16em;font-size:1.15rem;text-decoration:none}nav{display:flex;gap:24px}nav a{text-decoration:none;font-size:.86rem}.wrap{max-width:1250px;margin:auto;padding:0 6%}.hero{padding:105px 0 115px;display:grid;grid-template-columns:1.4fr .6fr;gap:7%;align-items:end}.eyebrow{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;font-weight:600}.hero h1{font-family:'DM Serif Display',serif;font-weight:400;line-height:1.07;letter-spacing:-.025em;font-size:clamp(3.1rem,6.6vw,6.8rem);margin:25px 0 30px}.hero h1 em{font-weight:400}.hero aside{font-size:1.05rem;max-width:340px;color:#43534d;padding-bottom:12px}.action{display:inline-block;margin-top:22px;padding:13px 23px;background:var(--ink);color:white;text-decoration:none;font-size:.9rem}section{padding:78px 0;border-top:1px solid var(--line)}h2{font-family:'DM Serif Display',serif;font-size:clamp(2.3rem,4vw,4.1rem);line-height:1.15;font-weight:400;margin:12px 0 32px}.intro{max-width:820px;font-size:1.35rem;line-height:1.6}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.card{border-top:1px solid #aeb9b0;padding-top:18px}.card h3{font-family:'DM Serif Display',serif;font-weight:400;font-size:1.65rem;line-height:1.15;margin:14px 0}.card p{color:#4b5a53;font-size:.95rem}.tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:35px}.tags span{border:1px solid #b6bfb8;padding:9px 15px;border-radius:30px;font-size:.85rem}.feature{background:#e8ebe4}.meta{font-size:.74rem;text-transform:uppercase;letter-spacing:.12em;color:#68776d}.link{display:inline-block;margin-top:16px;text-underline-offset:5px}.contact{background:var(--ink);color:white}.contact p{max-width:600px}footer{padding:24px 6%;background:#10251f;color:#d5e0d8;font-size:.8rem}footer a{margin-left:16px}@media(max-width:750px){header{align-items:flex-start;gap:20px;flex-direction:column}nav{flex-wrap:wrap;gap:12px 20px}.hero{grid-template-columns:1fr;padding:65px 0}.hero aside{max-width:100%}.grid{grid-template-columns:1fr}section{padding:55px 0}.intro{font-size:1.12rem}}
</style></head><body><header><a class="brand" href="#inicio">ALDO SANTOS</a><nav aria-label="Navegación principal"><a href="#perfil">Perfil</a><a href="#trabajo">Trabajo</a><a href="#proyectos">Proyectos</a><a href="#publicaciones">Publicaciones</a><a href="#contacto">Contacto</a></nav></header><main><div class="wrap"><div class="hero" id="inicio"><div><div class="eyebrow">Investigación · Consultoría · Diálogo</div><h1>Análisis para <em>comprender.</em><br/>Conocimiento para <em>actuar.</em></h1><a class="action" href="#trabajo">Explorar mi trabajo ↗</a></div><aside>Investigación aplicada, análisis de procesos territoriales y facilitación de espacios de diálogo y participación.</aside></div></div><section id="perfil"><div class="wrap"><div class="eyebrow">Perfil</div><h2>Una mirada interdisciplinaria</h2><p class="intro">Investigo y analizo procesos sociales, políticos y territoriales, con especial atención a las economías ilegales, la gobernanza, los conflictos socioambientales y los derechos de los pueblos indígenas. Mi experiencia combina investigación aplicada, análisis de políticas públicas y facilitación de procesos de diálogo y participación.</p></div></section><section class="feature" id="trabajo"><div class="wrap"><div class="eyebrow">Qué hago</div><h2>Investigar. Analizar. Facilitar.</h2><div class="grid"><div class="card"><div class="meta">01 / Investigación</div><h3>Comprender procesos complejos</h3><p>Investigaciones aplicadas, estudios técnicos y análisis de dinámicas sociales, políticas y territoriales.</p></div><div class="card"><div class="meta">02 / Consultoría</div><h3>Informar decisiones</h3><p>Diagnósticos, asesoramiento técnico y análisis de políticas públicas y gestión territorial.</p></div><div class="card"><div class="meta">03 / Diálogo</div><h3>Facilitar procesos</h3><p>Diseño, acompañamiento y facilitación de diálogo, consulta previa y participación intercultural.</p></div></div><div class="tags"><span>Crimen organizado y economías ilegales</span><span>Minería informal e ilegal</span><span>Territorio y gobernanza</span><span>Pueblos indígenas y derechos colectivos</span><span>Ambiente y conservación</span></div></div></section><section id="proyectos"><div class="wrap"><div class="eyebrow">Experiencia</div><h2>Proyectos seleccionados</h2><p>Este espacio reunirá una selección de trabajos que puedan compartirse públicamente.</p><div class="grid">{proyectos.map(item=><article class="card"><div class="meta">{item.data.category} · {item.data.date.getFullYear()}</div><h3><a href={`/proyectos/${item.id}/`}>{item.data.title}</a></h3><p>{item.data.description}</p></article>)}</div></div></section><section class="feature" id="publicaciones"><div class="wrap"><div class="eyebrow">Archivo</div><h2>Publicaciones y análisis</h2><p>Artículos, investigaciones y documentos de trabajo organizados para su consulta.</p><div class="grid">{publicaciones.map(item=><article class="card"><div class="meta">{item.data.category} · {item.data.date.toLocaleDateString('es-PE',{year:'numeric',month:'long'})}</div><h3><a href={`/publicaciones/${item.id}/`}>{item.data.title}</a></h3><p>{item.data.description}</p></article>)}</div></div></section><section class="contact" id="contacto"><div class="wrap"><div class="eyebrow">Contacto</div><h2>Conversemos.</h2><p>Para consultas profesionales, propuestas de investigación o colaboraciones, puedes escribirme. Incorporaremos aquí tu dirección de correo cuando la confirmes.</p></div></section></main><footer>© {new Date().getFullYear()} Aldo Santos · Sitio en preparación <a href="#inicio">Volver arriba ↑</a></footer></body></html>
