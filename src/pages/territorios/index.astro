---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { departamentos } from '../../data/departamentos.js';
---
<BaseLayout title="Territorios del Perú | Aldo Santos" description="Explorador territorial del Perú: acceso a 25 ámbitos departamentales y futuros indicadores oficiales." current="territorios">
<div class="wrap"><div class="territory-hero"><div class="eyebrow">Observatorio territorial / Perú</div><h1>El territorio como punto de partida.</h1><p class="territory-lead">Explora los 24 departamentos y la Provincia Constitucional del Callao. Este espacio reunirá indicadores oficiales, series históricas y análisis para comprender las diferencias territoriales del país.</p><div class="territory-controls"><label for="buscar-territorio" class="eyebrow">Buscar territorio</label><input id="buscar-territorio" class="territory-search" type="search" placeholder="Escribe un departamento o su código…" autocomplete="off" /></div><p id="territory-count" class="small-note" aria-live="polite">25 territorios</p></div></div>
<section class="territory-map-section" aria-labelledby="titulo-mapa"><div class="wrap"><div class="eyebrow">Cartografía interactiva</div><h2 id="titulo-mapa">Perú, departamento por departamento.</h2><p class="territory-map-intro">Selecciona un territorio sobre el mapa para abrir su ficha. También puedes utilizar el buscador o el directorio inferior.</p><div class="territory-map-layout"><div class="territory-map-frame"><div id="peru-map" class="peru-map" role="group" aria-label="Mapa interactivo de los departamentos del Perú"><p class="territory-map-loading">Cargando límites departamentales…</p></div><div id="map-status" class="small-note" role="status" aria-live="polite"></div></div><aside class="territory-map-aside"><div class="eyebrow">Territorio seleccionado</div><h3 id="map-selection">Explora el mapa.</h3><p id="map-hint">Pasa el cursor sobre un departamento o selecciónalo para acceder a su ficha.</p><a id="map-link" class="link" href="/territorios/" hidden>Ver ficha territorial ↗</a><p class="small-note">Cartografía de origen: INEI; procesamiento y simplificación: Luis Rodas (Peru-maps, 2026). Límites referenciales para uso estadístico, no para demarcación legal.</p></aside></div></div></section>
<section class="feature"><div class="wrap"><div class="eyebrow">Explorar por departamento</div><h2>25 territorios. Múltiples perspectivas.</h2><div class="territory-grid" id="territory-grid">{departamentos.map(d=><a class="territory-item" href={`/territorios/${d.slug}/`} data-search={`${d.nombre.toLocaleLowerCase('es-PE')} ${d.ubigeo}`}><span>{d.nombre}</span><small>{d.ubigeo} ↗</small></a>)}</div><p class="territory-note" style="margin-top:24px">Los códigos de dos dígitos corresponden al prefijo departamental del UBIGEO. El mapa permite explorar la división departamental; los indicadores se incorporarán progresivamente a partir de bases oficiales verificadas.</p></div></section>
<section><div class="wrap"><div class="eyebrow">Próximas capas de información</div><h2>Del dato al análisis territorial.</h2><div class="grid"><div class="card"><div class="meta">01 / Contexto</div><h3>Población y condiciones de vida</h3><p>Indicadores demográficos, pobreza, educación, salud y servicios básicos.</p></div><div class="card"><div class="meta">02 / Dinámicas</div><h3>Economía y gestión pública</h3><p>Actividad económica, empleo, inversión y capacidades institucionales.</p></div><div class="card"><div class="meta">03 / Análisis</div><h3>Seguridad, ambiente y gobernanza</h3><p>Conflictividad, economías ilegales, pueblos indígenas y conservación, según disponibilidad de fuentes.</p></div></div></div></section>
<script is:inline>const input=document.getElementById('buscar-territorio');const cards=[...document.querySelectorAll('.territory-item')];const count=document.getElementById('territory-count');const normalize=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();input?.addEventListener('input',()=>{const q=normalize(input.value.trim());let n=0;for(const card of cards){const ok=normalize(card.dataset.search||'').includes(q);card.hidden=!ok;if(ok)n++;}count.textContent=`${n} territorio${n===1?'':'s'}`;});</script>
<script>
const endpoint='/data/departamentos.geojson';
const map=document.getElementById('peru-map');const status=document.getElementById('map-status');const title=document.getElementById('map-selection');const hint=document.getElementById('map-hint');const link=document.getElementById('map-link');
const norm=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const refs=Array.from(document.querySelectorAll('.territory-item')).map(a=>({name:a.querySelector('span')?.textContent||'',code:a.querySelector('small')?.textContent.trim().slice(0,2)||'',href:a.getAttribute('href')}));
const SVG='http://www.w3.org/2000/svg';const el=(tag,attrs={})=>{const n=document.createElementNS(SVG,tag);for(const [k,v] of Object.entries(attrs))n.setAttribute(k,String(v));return n;};
function geometryRings(g){if(!g)return [];if(g.type==='Polygon')return g.coordinates;if(g.type==='MultiPolygon')return g.coordinates.flat();if(g.type==='GeometryCollection')return g.geometries.flatMap(geometryRings);return [];}
function pickFeature(f){const p=f.properties||{};const code=String(p.ubigeo||p.ccdd||p.CD_DEPA||p.FIRST_IDDP||p.code||'').padStart(2,'0');return refs.find(r=>r.code===code)||refs.find(r=>norm(r.name)===norm(p.nombre||p.NM_DEPA||p.NOMBDEP||p.name));}
function focus(ref){if(!ref)return;title.textContent=ref.name;hint.textContent='Código departamental '+ref.code;link.href=ref.href;link.hidden=false;}
async function draw(){try{const response=await fetch(endpoint);if(!response.ok)throw Error('HTTP '+response.status);const geo=await response.json();if(!Array.isArray(geo.features)||geo.features.length!==25)throw Error('Sin geometrías');const items=geo.features.map(f=>({f,ref:pickFeature(f),rings:geometryRings(f.geometry)})).filter(o=>o.ref&&o.rings.length);if(items.length!==25)throw Error('La fuente no devolvió los 25 territorios');let x0=Infinity,x1=-Infinity,y0=Infinity,y1=-Infinity;for(const o of items){for(const ring of o.rings){for(const [x,y] of ring){if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;}}}const width=660,height=840,pad=26,scale=Math.min((width-2*pad)/(x1-x0),(height-2*pad)/(y1-y0));const ox=(width-(x1-x0)*scale)/2,oy=(height-(y1-y0)*scale)/2;const pt=([x,y])=>[(ox+(x-x0)*scale).toFixed(2),(height-oy-(y-y0)*scale).toFixed(2)];const svg=el('svg',{viewBox:`0 0 ${width} ${height}`,role:'img','aria-label':'Mapa departamental del Perú'});const paths=[];for(const o of items){const d=o.rings.map(r=>r.map((c,i)=>(i?'L':'M')+pt(c).join(' ')).join(' ')+' Z').join(' ');const a=el('a',{href:o.ref.href,'aria-label':`Abrir ficha de ${o.ref.name}`});const path=el('path',{d,class:'peru-department','data-code':o.ref.code,tabindex:'0','aria-label':o.ref.name});const t=el('title');t.textContent=o.ref.name;path.append(t);path.addEventListener('mouseenter',()=>focus(o.ref));path.addEventListener('focus',()=>focus(o.ref));path.addEventListener('click',()=>focus(o.ref));path.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();window.location.href=o.ref.href;}});a.append(path);svg.append(a);paths.push({path,ref:o.ref});}map.replaceChildren(svg);status.textContent=`${items.length} territorios representados. Selecciona uno para abrir su ficha.`;const search=document.getElementById('buscar-territorio');search?.addEventListener('input',()=>{const q=norm(search.value.trim());for(const {path,ref} of paths){path.classList.toggle('is-match',!!q&&(norm(ref.name).includes(q)||ref.code.includes(q)));path.classList.toggle('is-muted',!!q&&!(norm(ref.name).includes(q)||ref.code.includes(q)));}const found=q&&paths.find(({ref})=>norm(ref.name).includes(q)||ref.code.includes(q));if(found)focus(found.ref);});}catch(e){map.innerHTML='<p class="territory-map-loading">No fue posible cargar el mapa en este momento. Puedes seguir navegando mediante el directorio de departamentos.</p>';status.textContent='No se pudo leer el archivo cartográfico local.';console.error('Mapa territorial:',e);}}
draw();
</script>
</BaseLayout>
