---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { departamentos } from '../../data/departamentos.js';
export function getStaticPaths(){return departamentos.map(d=>({params:{slug:d.slug},props:{departamento:d}}));}
const { departamento }=Astro.props;
const esLoreto=departamento.ubigeo==='16';
---
<BaseLayout title={`${departamento.nombre} | Territorios | Aldo Santos`} description={`Perfil territorial de ${departamento.nombre}: estructura inicial para indicadores oficiales y análisis.`} current="territorios">
<div class="wrap"><div class="territory-breadcrumb"><a href="/territorios/">← Todos los territorios</a></div><div class="territory-hero" style="padding-top:30px"><div class="eyebrow">Perfil territorial · UBIGEO {departamento.ubigeo}</div><h1>{departamento.nombre}.</h1><p class="territory-lead">{esLoreto?'Loreto será el primer territorio piloto para integrar indicadores oficiales, mapas y análisis documentados.':'Ficha territorial en preparación. Los indicadores se incorporarán de forma progresiva a partir de fuentes oficiales verificadas.'}</p><div><span class="territory-pill">Perú</span><span class="territory-pill">Código departamental {departamento.ubigeo}</span><span class="territory-pill">En desarrollo</span></div></div></div>
<section class="feature"><div class="wrap"><div class="eyebrow">Panel de indicadores</div><h2>Información territorial.</h2><p class="territory-note">Todavía no se han cargado series estadísticas para este territorio. No mostramos cifras de ejemplo para evitar confundirlas con datos oficiales.</p><div class="grid"><div class="card"><div class="meta">Población y sociedad</div><h3>Indicadores pendientes</h3><p>INEI: población, pobreza y condiciones de vida.</p></div><div class="card"><div class="meta">Economía y gestión</div><h3>Indicadores pendientes</h3><p>INEI y MEF: economía, inversión y gestión pública.</p></div><div class="card"><div class="meta">Territorio y gobernanza</div><h3>Indicadores pendientes</h3><p>Seguridad, conflictividad, ambiente y derechos colectivos.</p></div></div></div></section>
<section><div class="wrap"><div class="eyebrow">Método y fuentes</div><h2>Datos con contexto.</h2><p class="profile-copy">Cada indicador publicado identificará la institución responsable, año de referencia, unidad de medida, cobertura territorial y notas metodológicas. Los códigos UBIGEO facilitarán la vinculación de bases oficiales, previa revisión de compatibilidad territorial y temporal.</p><a class="link" href="/territorios/">← Explorar otro territorio</a></div></section>
</BaseLayout>
