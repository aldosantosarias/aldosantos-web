---
const {title='Aldo Santos — Investigación, consultoría y diálogo',description='Investigación, consultoría y facilitación de procesos de diálogo.',current=''}=Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet"/><style is:global>
:root{--ink:#17302a;--paper:#f7f5f0;--muted:#626a64;--line:#d7d9d0}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;line-height:1.65}a{color:inherit}header{padding:24px 6%;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.brand{font-family:'DM Serif Display',serif;letter-spacing:.16em;font-size:1.15rem;text-decoration:none}nav{display:flex;gap:24px}nav a{text-decoration:none;font-size:.86rem}.wrap{max-width:1250px;margin:auto;padding:0 6%}.hero{padding:105px 0 115px;display:grid;grid-template-columns:1.4fr .6fr;gap:7%;align-items:end}.eyebrow{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;font-weight:600}.hero h1{font-family:'DM Serif Display',serif;font-weight:400;line-height:1.07;letter-spacing:-.025em;font-size:clamp(3.1rem,6.6vw,6.8rem);margin:25px 0 30px}.hero h1 em{font-weight:400}.hero aside{font-size:1.05rem;max-width:340px;color:#43534d;padding-bottom:12px}.action{display:inline-block;margin-top:22px;padding:13px 23px;background:var(--ink);color:white;text-decoration:none;font-size:.9rem}section{padding:78px 0;border-top:1px solid var(--line)}h2{font-family:'DM Serif Display',serif;font-size:clamp(2.3rem,4vw,4.1rem);line-height:1.15;font-weight:400;margin:12px 0 32px}.intro{max-width:820px;font-size:1.35rem;line-height:1.6}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.card{border-top:1px solid #aeb9b0;padding-top:18px}.card h3{font-family:'DM Serif Display',serif;font-weight:400;font-size:1.65rem;line-height:1.15;margin:14px 0}.card p{color:#4b5a53;font-size:.95rem}.tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:35px}.tags span{border:1px solid #b6bfb8;padding:9px 15px;border-radius:30px;font-size:.85rem}.feature{background:#e8ebe4}.meta{font-size:.74rem;text-transform:uppercase;letter-spacing:.12em;color:#68776d}.link{display:inline-block;margin-top:16px;text-underline-offset:5px}.contact{background:var(--ink);color:white}.contact p{max-width:600px}footer{padding:24px 6%;background:#10251f;color:#d5e0d8;font-size:.8rem}footer a{margin-left:16px}@media(max-width:750px){header{align-items:flex-start;gap:20px;flex-direction:column}nav{flex-wrap:wrap;gap:12px 20px}.hero{grid-template-columns:1fr;padding:65px 0}.hero aside{max-width:100%}.grid{grid-template-columns:1fr}section{padding:55px 0}.intro{font-size:1.12rem}}

nav a[aria-current="page"]{text-decoration:underline;text-underline-offset:7px}.profile-hero{padding:90px 0 70px}.profile-hero h1{font:400 clamp(3.2rem,7vw,7rem)/1.06 'DM Serif Display',serif;letter-spacing:-.025em;max-width:1000px;margin:20px 0 30px}.profile-lead{font-size:clamp(1.2rem,2.3vw,1.65rem);max-width:850px;line-height:1.6}.profile-copy{max-width:820px;font-size:1.08rem;line-height:1.85}.profile-copy p{margin:0 0 1.3em}.institution-list{max-width:850px;line-height:1.9}.split{display:grid;grid-template-columns:1fr 1fr;gap:50px}.split h3{font:400 1.75rem 'DM Serif Display',serif}.small-note{font-size:.85rem;color:var(--muted)}@media(max-width:750px){.split{grid-template-columns:1fr}.profile-hero{padding:65px 0 45px}}

.territory-hero{padding:90px 0 65px}.territory-hero h1{font:400 clamp(3rem,6vw,6rem)/1.08 'DM Serif Display',serif;max-width:960px;margin:20px 0}.territory-lead{max-width:760px;font-size:1.2rem;color:#43534d}.territory-controls{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin:30px 0}.territory-search{width:min(100%,480px);font:inherit;padding:14px 17px;border:1px solid #9aaca0;background:#fff;color:var(--ink)}.territory-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.territory-item{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:19px 16px;text-decoration:none;border:1px solid #bdc8be;background:#f9faf6;transition:background .2s}.territory-item:hover,.territory-item:focus-visible{background:#dbe5d9}.territory-item small{font-size:.72rem;color:#66796d}.territory-item[hidden]{display:none}.territory-note{max-width:840px;font-size:.91rem;color:#5a685f}.territory-breadcrumb{font-size:.85rem;margin:30px 0}.territory-empty{padding:30px 0;border-top:1px solid var(--line);color:#526158}.territory-pill{display:inline-block;padding:7px 13px;border:1px solid #a6b7ab;border-radius:30px;font-size:.78rem;margin:6px 6px 6px 0}@media(max-width:900px){.territory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:550px){.territory-grid{grid-template-columns:1fr}.territory-hero{padding:55px 0 40px}}

/* Mapa territorial: estilos aislados del resto del sitio */
.territory-map-section{background:#f7f5f0}.territory-map-intro{max-width:730px;color:#43534d;font-size:1.05rem}.territory-map-layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(240px,.6fr);gap:48px;align-items:start;margin-top:28px}.territory-map-frame{min-width:0}.peru-map{background:#e8ebe4;border:1px solid #cbd3c9;min-height:420px;display:flex;justify-content:center;align-items:center;padding:20px}.peru-map svg{display:block;width:100%;max-width:570px;height:auto;max-height:730px;overflow:visible}.peru-department{fill:#d6e1d6;stroke:#607a6e;stroke-width:1.1;vector-effect:non-scaling-stroke;cursor:pointer;transition:fill .15s ease,opacity .15s ease}.peru-department:hover,.peru-department:focus,.peru-department.is-match{fill:#6e9c83;outline:none}.peru-department.is-muted{opacity:.24}.territory-map-aside{padding-top:22px}.territory-map-aside h3{font:400 clamp(1.9rem,3vw,2.7rem)/1.15 'DM Serif Display',serif;margin:18px 0}.territory-map-aside p{color:#43534d}.territory-map-aside .small-note{border-top:1px solid #d7d9d0;margin-top:45px;padding-top:20px}.territory-map-loading{padding:30px;color:#43534d;text-align:center}.territory-item[hidden]{display:none!important}@media(max-width:800px){.territory-map-layout{grid-template-columns:1fr;gap:12px}.peru-map{min-height:340px;padding:10px}.territory-map-aside .small-note{margin-top:20px}}
</style></head><body><header><a class="brand" href="/">ALDO SANTOS</a><nav aria-label="Navegación principal"><a href="/perfil/" aria-current={current==='perfil'?'page':undefined}>Perfil</a><a href="/#trabajo">Trabajo</a><a href="/#proyectos">Proyectos</a><a href="/#publicaciones">Publicaciones</a><a href="/territorios/" aria-current={current==='territorios'?'page':undefined}>Territorios</a><a href="/#contacto">Contacto</a></nav></header><main><slot/></main><footer>© {new Date().getFullYear()} Aldo Santos · <a href="/">Inicio ↑</a></footer></body></html>